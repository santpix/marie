<section class="mv-overlap" style="background-image:url('{{ section.settings.background_asset | asset_url }}')"><div class="mv-overlap__shade"></div><img class="mv-overlap__float" src="{{ section.settings.foreground_asset | asset_url }}" alt="" loading="lazy"><div class="mv-overlap__copy"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2>{{ section.settings.text }}{% if section.settings.button != blank %}<a href="{{ section.settings.link }}">{{ section.settings.button }}</a>{% endif %}</div></section>
{% schema %}{"name":"Marie Vogue overlap","settings":[{"type":"text","id":"background_asset","label":"Background asset","default":"marie-hero-03.jpg"},{"type":"text","id":"foreground_asset","label":"Foreground asset","default":"marie-lounging.jpg"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"IRISH HERITAGE"},{"type":"text","id":"heading","label":"Heading","default":"TRADITION, SHAPED FOR NOW"},{"type":"richtext","id":"text","label":"Text","default":"<p>Heritage, craftsmanship and a modern point of view come together in every silhouette.</p>"},{"type":"text","id":"button","label":"Button","default":"READ THE STORY"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Marie Vogue overlap"}]}{% endschema %}