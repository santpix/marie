<section class="mv-marquee"><a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="mv-marquee__link"><span>{{ section.settings.text }}</span>{% if section.settings.asset != blank %}<img src="{{ section.settings.asset | asset_url }}" alt="" loading="lazy">{% endif %}<span aria-hidden="true">{{ section.settings.text }}</span></a></section>
{% schema %}{"name":"Marie Vogue marquee","settings":[{"type":"text","id":"text","label":"Text","default":"SHOP THE COLLECTION"},{"type":"text","id":"asset","label":"Theme asset filename","default":"marie-blog-yellow-paris.jpg"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Marie Vogue marquee"}]}{% endschema %}