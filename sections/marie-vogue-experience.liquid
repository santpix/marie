{% assign products_all = collections.all.products %}
<section class="mvx" data-mvx>
  <div class="mvx-announcement">COMPLIMENTARY SHIPPING — MARIE GALVIN MILLINERY</div>
  <header class="mvx-home-header" data-home-header>
    <button class="mvx-iconbtn" type="button" aria-label="Open menu" data-menu-open><span></span><span></span></button>
    <a class="mvx-wordmark" href="{{ routes.root_url }}"><img src="{{ 'marie-logo.jpg' | asset_url }}" alt="{{ shop.name | escape }}"></a>
    <div class="mvx-header-actions">
      {% if localization.available_countries.size > 1 %}<span class="mvx-country">{{ localization.country.iso_code }} · {{ localization.country.currency.iso_code }}</span>{% endif %}
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account">ACCOUNT</a>{% endif %}
      <button class="mvx-textbtn" type="button" data-search-open>SEARCH</button>
      <a href="{{ routes.cart_url }}">CART <span data-cart-count>{{ cart.item_count }}</span></a>
    </div>
  </header>

  <aside class="mvx-drawer" data-menu-drawer aria-hidden="true">
    <button class="mvx-drawer-close" type="button" data-menu-close aria-label="Close menu">×</button>
    <nav>
      <a href="{{ routes.all_products_collection_url }}">SHOP ALL</a>
      <a href="/collections/kentucky-derby-hats">KENTUCKY DERBY HATS</a>
      <a href="/collections/wedding-hats">WEDDING HATS</a>
      <a href="/collections/ready-to-wear">READY TO WEAR</a>
      <a href="/pages/custom-designs">CUSTOM DESIGNS</a>
      <a href="/pages/about">ABOUT</a>
      <a href="/blogs/news">JOURNAL</a>
      <a href="/pages/contact">CONTACT</a>
    </nav>
    <div class="mvx-drawer-foot">MARIE GALVIN MILLINERY<br>IRISH HERITAGE · CONTEMPORARY CRAFT</div>
  </aside>

  <aside class="mvx-search" data-search-drawer aria-hidden="true">
    <button class="mvx-drawer-close" type="button" data-search-close aria-label="Close search">×</button>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label for="MvxSearch">SEARCH</label>
      <div><input id="MvxSearch" type="search" name="q" placeholder="Search hats, collections, journal" autocomplete="off"><button type="submit">GO</button></div>
    </form>
  </aside>
  <div class="mvx-scrim" data-scrim></div>

  <section class="mvx-hero" data-hero>
    <div class="mvx-hero__slide is-active" style="background-image:url('{{ 'marie-hero-01.jpg' | asset_url }}')"></div>
    <div class="mvx-hero__slide" style="background-image:url('{{ 'marie-hero-02.jpg' | asset_url }}')"></div>
    <div class="mvx-hero__slide" style="background-image:url('{{ 'marie-hero-03.jpg' | asset_url }}')"></div>
    <div class="mvx-overlay"></div>
    <div class="mvx-hero__copy" data-mvx-reveal><span>SS26 COLLECTION</span><h1>LA BELLE ÉPOQUE</h1><a href="{{ routes.all_products_collection_url }}">SHOP NOW</a></div>
    <div class="mvx-dots"><button class="is-active" data-i="0" aria-label="Slide 1"></button><button data-i="1" aria-label="Slide 2"></button><button data-i="2" aria-label="Slide 3"></button></div>
  </section>

  <section class="mvx-products" data-tabs data-mvx-reveal>
    <div class="mvx-section-head"><p>FEATURED COLLECTION</p><div class="mvx-tabs"><button class="is-active" data-tab="new">NEW STYLES</button><button data-tab="signature">SIGNATURE</button></div></div>
    <div class="mvx-product-panel is-active" data-panel="new"><div class="mvx-product-track">{% for product in products_all limit: 6 %}{% render 'marie-vogue-card', product: product %}{% endfor %}</div><a class="mvx-yellow" href="{{ routes.all_products_collection_url }}">VIEW ALL</a></div>
    <div class="mvx-product-panel" data-panel="signature"><div class="mvx-product-track">{% for product in products_all offset: 6 limit: 6 %}{% render 'marie-vogue-card', product: product %}{% endfor %}</div><a class="mvx-yellow" href="{{ routes.all_products_collection_url }}">VIEW ALL</a></div>
  </section>

  <a class="mvx-marquee" href="{{ routes.all_products_collection_url }}" data-mvx-reveal><span>MARIE GALVIN MILLINERY</span><img src="{{ 'marie-blog-black-white.jpg' | asset_url }}" alt=""></a>
  <a class="mvx-marquee mvx-marquee--reverse" href="{{ routes.all_products_collection_url }}" data-mvx-reveal><img src="{{ 'marie-blog-yellow-paris.jpg' | asset_url }}" alt=""><span>THE OCCASION EDIT</span></a>

  <section class="mvx-categories" data-mvx-reveal>
    <a href="/collections/wedding-hats"><img src="{{ 'marie-blog-black-white.jpg' | asset_url }}" alt=""><span>WEDDINGS</span><b>VIEW PRODUCTS</b></a>
    <a href="/collections/kentucky-derby-hats"><img src="{{ 'marie-blog-autumn.jpg' | asset_url }}" alt=""><span>RACE DAY</span><b>VIEW PRODUCTS</b></a>
    <a href="/collections/ready-to-wear"><img src="{{ 'marie-blog-yellow-paris.jpg' | asset_url }}" alt=""><span>READY TO WEAR</span><b>VIEW PRODUCTS</b></a>
    <a href="/pages/custom-designs"><img src="{{ 'marie-lounging.jpg' | asset_url }}" alt=""><span>BESPOKE</span><b>DISCOVER</b></a>
  </section>

  <section class="mvx-products mvx-products--second" data-mvx-reveal>
    <div class="mvx-section-head"><div><p>OUR NEW STYLES</p><h2>YOUR SIGNATURE LOOK</h2></div></div>
    <div class="mvx-product-track">{% for product in products_all limit: 8 %}{% render 'marie-vogue-card', product: product %}{% endfor %}</div>
    <a class="mvx-yellow" href="{{ routes.all_products_collection_url }}">VIEW ALL HATS</a>
  </section>

  <section class="mvx-ba" data-ba data-mvx-reveal>
    <div class="mvx-ba__title"><p>FROM SKETCH</p><h2>TO STATEMENT</h2></div>
    <div class="mvx-ba__stage">
      <img class="mvx-ba__base" src="{{ 'marie-hero-03.jpg' | asset_url }}" alt="Finished Marie Galvin look">
      <div class="mvx-ba__top" data-ba-top><img src="{{ 'marie-hero-01.jpg' | asset_url }}" alt="Marie Galvin inspiration"></div>
      <div class="mvx-ba__line" data-ba-line><span>↔</span></div>
      <input type="range" min="0" max="100" value="50" aria-label="Compare images" data-ba-range>
      <span class="mvx-ba__label mvx-ba__label--left">INSPIRATION</span><span class="mvx-ba__label mvx-ba__label--right">FINISHED LOOK</span>
    </div>
  </section>

  <section class="mvx-look" data-mvx-reveal>
    <div class="mvx-look__image" style="background-image:url('{{ 'marie-hero-02.jpg' | asset_url }}')"><span>THE EDIT</span><h2>DISCOVER THE RANGE</h2></div>
    <div class="mvx-look__products"><p>SHOP THE LOOK</p>{% for product in products_all limit: 3 %}{% render 'marie-vogue-card', product: product %}{% endfor %}<a class="mvx-yellow" href="{{ routes.all_products_collection_url }}">VIEW PRODUCTS</a></div>
  </section>

  <section class="mvx-promo" style="background-image:url('{{ 'marie-hero-03.jpg' | asset_url }}')" data-mvx-reveal>
    <div class="mvx-overlay"></div><div class="mvx-promo__copy"><span>SPECIAL OCCASIONS</span><h2>MADE TO BE REMEMBERED</h2><p>Statement millinery for weddings, race days and the moments that call for something extraordinary.</p><a href="{{ routes.all_products_collection_url }}">SHOP NOW</a></div>
    <div class="mvx-count"><b>00</b><span>DAY</span><i>:</i><b>00</b><span>HOURS</span><i>:</i><b>00</b><span>MIN</span><i>:</i><b>00</b><span>SEC</span></div>
  </section>

  <section class="mvx-split" data-mvx-reveal>
    <div class="mvx-split__copy"><p>THE MILLINER'S CHRONICLES</p><h2>CRAFTED BY HAND.<br>WORN WITH INTENTION.</h2><span>Marie Galvin has spent more than two decades creating sculptural headpieces rooted in traditional millinery craft and a distinctly contemporary point of view.</span><a class="mvx-yellow" href="/pages/about">DISCOVER MARIE</a></div>
    <div class="mvx-split__media"><img class="one" src="{{ 'marie-hero-01.jpg' | asset_url }}" alt=""><img class="two" src="{{ 'marie-lounging.jpg' | asset_url }}" alt=""></div>
  </section>

  <section class="mvx-overlap" style="background-image:url('{{ 'marie-hero-02.jpg' | asset_url }}')" data-mvx-reveal>
    <img src="{{ 'marie-lounging.jpg' | asset_url }}" alt=""><div class="mvx-overlap__copy"><p>IRISH HERITAGE & CRAFTSMANSHIP</p><h2>TRADITION, SHAPED FOR NOW</h2><span>Inspired by Ireland's Wild Atlantic Way, Marie's work brings heritage techniques into a modern, expressive vocabulary of form, color and occasion.</span></div>
  </section>

  {% assign featured = products_all.first %}{% if featured %}
  <section class="mvx-featured" data-mvx-reveal>
    <div class="mvx-featured__gallery">{% if featured.featured_image %}<img src="{{ featured.featured_image | image_url: width: 2000 }}" alt="{{ featured.title | escape }}">{% endif %}</div>
    <div class="mvx-featured__info"><p>MARIE GALVIN MILLINERY</p><h2>{{ featured.title }}</h2><div class="mvx-price">{{ featured.price | money }}</div><div class="mvx-desc">{{ featured.description | strip_html | truncatewords: 42 }}</div><form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ featured.selected_or_first_available_variant.id }}"><button type="submit">ADD TO CART</button></form></div>
  </section>{% endif %}

  <section class="mvx-inspirations" data-mvx-reveal><p>OUR INSPIRATIONS</p><div><img src="{{ 'marie-blog-black-white.jpg' | asset_url }}" alt=""><img src="{{ 'marie-blog-autumn.jpg' | asset_url }}" alt=""><img src="{{ 'marie-blog-yellow-paris.jpg' | asset_url }}" alt=""><img src="{{ 'marie-lounging.jpg' | asset_url }}" alt=""><img src="{{ 'marie-hero-03.jpg' | asset_url }}" alt=""></div></section>

  <section class="mvx-journal" data-mvx-reveal>
    <div class="mvx-section-head"><div><p>NEWS</p><h2>FROM THE JOURNAL</h2></div><a href="/blogs/news">VIEW ALL</a></div>
    <div class="mvx-journal-grid"><article><img src="{{ 'marie-blog-black-white.jpg' | asset_url }}" alt=""><small>STYLE</small><h3>How to choose a hat for the occasion</h3><a href="/blogs/news">READ MORE</a></article><article><img src="{{ 'marie-blog-autumn.jpg' | asset_url }}" alt=""><small>ATELIER</small><h3>Inside the craft of modern millinery</h3><a href="/blogs/news">READ MORE</a></article><article><img src="{{ 'marie-blog-yellow-paris.jpg' | asset_url }}" alt=""><small>INSPIRATION</small><h3>Statement silhouettes for race day</h3><a href="/blogs/news">READ MORE</a></article></div>
  </section>

  <section class="mvx-social" data-mvx-reveal><p>FOLLOW US</p><h2>@MARIEGALVINMILLINERY</h2><div><img src="{{ 'marie-blog-black-white.jpg' | asset_url }}" alt=""><img src="{{ 'marie-blog-autumn.jpg' | asset_url }}" alt=""><img src="{{ 'marie-blog-yellow-paris.jpg' | asset_url }}" alt=""><img src="{{ 'marie-lounging.jpg' | asset_url }}" alt=""><img src="{{ 'marie-hero-02.jpg' | asset_url }}" alt=""><img src="{{ 'marie-hero-03.jpg' | asset_url }}" alt=""></div></section>

  <div class="mvx-newsletter" data-newsletter><button data-close aria-label="Close">×</button><p>GET ON OUR LIST</p><span>Be the first to shop new arrivals and exclusive promotions.</span>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required><button type="submit">SUBSCRIBE</button>{% endform %}</div>
</section>

<script>
(()=>{const r=document.querySelector('[data-mvx]');if(!r||r.dataset.ready)return;r.dataset.ready='1';document.documentElement.classList.add('mvx-js');
const slides=[...r.querySelectorAll('.mvx-hero__slide')],dots=[...r.querySelectorAll('.mvx-dots button')];let n=0;const show=i=>{n=(i+slides.length)%slides.length;slides.forEach((x,j)=>x.classList.toggle('is-active',j===n));dots.forEach((x,j)=>x.classList.toggle('is-active',j===n))};dots.forEach((x,i)=>x.addEventListener('click',()=>show(i)));if(!matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(()=>show(n+1),6500);
const tabs=[...r.querySelectorAll('[data-tab]')],panels=[...r.querySelectorAll('[data-panel]')];tabs.forEach(t=>t.addEventListener('click',()=>{tabs.forEach(x=>x.classList.remove('is-active'));panels.forEach(x=>x.classList.remove('is-active'));t.classList.add('is-active');r.querySelector(`[data-panel="${t.dataset.tab}"]`)?.classList.add('is-active')}));
const drawer=r.querySelector('[data-menu-drawer]'),search=r.querySelector('[data-search-drawer]'),scrim=r.querySelector('[data-scrim]');const shut=()=>{drawer?.classList.remove('is-open');search?.classList.remove('is-open');scrim?.classList.remove('is-open');document.body.classList.remove('mvx-lock')};const open=(el)=>{shut();el?.classList.add('is-open');scrim?.classList.add('is-open');document.body.classList.add('mvx-lock')};r.querySelector('[data-menu-open]')?.addEventListener('click',()=>open(drawer));r.querySelector('[data-search-open]')?.addEventListener('click',()=>open(search));r.querySelector('[data-menu-close]')?.addEventListener('click',shut);r.querySelector('[data-search-close]')?.addEventListener('click',shut);scrim?.addEventListener('click',shut);document.addEventListener('keydown',e=>{if(e.key==='Escape')shut()});
const ba=r.querySelector('[data-ba]');if(ba){const range=ba.querySelector('[data-ba-range]'),top=ba.querySelector('[data-ba-top]'),line=ba.querySelector('[data-ba-line]');const set=v=>{top.style.clipPath=`inset(0 ${100-v}% 0 0)`;line.style.left=`${v}%`};range.addEventListener('input',e=>set(+e.target.value));set(+range.value)}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('mvx-in');io.unobserve(e.target)}}),{threshold:.12});r.querySelectorAll('[data-mvx-reveal]').forEach(el=>io.observe(el));
const header=r.querySelector('[data-home-header]');let last=0;addEventListener('scroll',()=>{const y=scrollY;header?.classList.toggle('is-solid',y>60);header?.classList.toggle('is-hidden',y>500&&y>last);last=y},{passive:true});
const q=r.querySelector('[data-newsletter]');r.querySelector('[data-close]')?.addEventListener('click',()=>q?.remove());})();
</script>
