<section class="mv-promo" style="background-image:url('{{ section.settings.asset | asset_url }}')"><div class="mv-promo__shade"></div><div class="mv-promo__copy"><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="mv-promo__text">{{ section.settings.text }}</div>{% if section.settings.button != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button }}</a>{% endif %}</div></section>
{% schema %}{"name":"Marie Vogue promo","settings":[{"type":"text","id":"asset","label":"Theme asset filename","default":"marie-hero-02.jpg"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"MARIE GALVIN MILLINERY"},{"type":"text","id":"heading","label":"Heading","default":"MADE FOR THE MOMENT"},{"type":"richtext","id":"text","label":"Text","default":"<p>Statement millinery shaped by craft, character and occasion.</p>"},{"type":"text","id":"button","label":"Button","default":"DISCOVER MORE"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Marie Vogue promo"}]}{% endschema %}