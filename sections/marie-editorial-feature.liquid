<section class="marie-feature marie-feature--{{ section.settings.image_position }}">
  <div class="marie-feature__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '(min-width: 990px) 58vw, 100vw', class: 'marie-feature__image' }}
    {% elsif section.settings.fallback_asset != blank %}
      <img class="marie-feature__image" src="{{ section.settings.fallback_asset | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {% else %}
      <div class="marie-feature__placeholder"></div>
    {% endif %}
  </div>
  <div class="marie-feature__copy">
    {% if section.settings.eyebrow != blank %}<p class="marie-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="marie-feature__text rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="marie-text-link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Marie editorial feature",
  "tag": "section",
  "class": "marie-section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"fallback_asset","label":"Automatic asset filename"},
    {"type":"select","id":"image_position","label":"Image position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ATELIER"},
    {"type":"text","id":"heading","label":"Heading","default":"Made to be remembered."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Statement millinery presented with the restraint of a fashion editorial.</p>"},
    {"type":"text","id":"button_label","label":"Link label","default":"Discover more"},
    {"type":"url","id":"button_link","label":"Link"}
  ],
  "presets": [{"name":"Marie editorial feature"}]
}
{% endschema %}
