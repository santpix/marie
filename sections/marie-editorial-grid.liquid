<section class="marie-grid-wrap">
  <div class="marie-grid-head">
    {% if section.settings.eyebrow != blank %}<p class="marie-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
  </div>
  <div class="marie-grid">
    {% for block in section.blocks %}
      <article class="marie-grid__item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
          <div class="marie-grid__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1600', sizes: '(min-width: 990px) 33vw, 100vw' }}
            {% else %}
              <div class="marie-grid__placeholder"></div>
            {% endif %}
          </div>
          <div class="marie-grid__caption">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.label != blank %}<span>{{ block.settings.label }}</span>{% endif %}
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name":"Marie editorial grid",
  "tag":"section",
  "class":"marie-section",
  "max_blocks":3,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"CURATED"},
    {"type":"text","id":"heading","label":"Heading","default":"The Edit"}
  ],
  "blocks":[{
    "type":"tile","name":"Editorial tile","settings":[
      {"type":"image_picker","id":"image","label":"Image"},
      {"type":"text","id":"title","label":"Title","default":"Occasion"},
      {"type":"text","id":"label","label":"Link label","default":"Explore"},
      {"type":"url","id":"link","label":"Link"}
    ]
  }],
  "presets":[{"name":"Marie editorial grid","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]
}
{% endschema %}