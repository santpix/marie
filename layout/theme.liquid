<!doctype html>
<html {% if request.design_mode %}class="shopify-design-mode"{% endif %} lang="{{ request.locale.iso_code }}">
<head>
{%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
{%- render 'view-transition-opt-in' -%}{%- render 'meta-tags' -%}{%- render 'stylesheets' -%}{%- render 'card-hover-effect-styles' -%}{%- render 'fonts' -%}{%- render 'scripts' -%}{%- render 'theme-styles-variables' -%}{%- render 'color-palette' -%}
{{ 'marie-editorial.css' | asset_url | stylesheet_tag }}{{ 'marie-vogue.css' | asset_url | stylesheet_tag }}{{ 'marie-vogue-experience.css' | asset_url | stylesheet_tag }}{{ 'prestige-vogue-global.css' | asset_url | stylesheet_tag }}{{ 'prestige-vogue-reference.css' | asset_url | stylesheet_tag }}
{% if request.design_mode %}{%- render 'theme-editor' -%}{% endif %}{{ content_for_header }}
<style id="marie-native-header-force">
.template-index #header-group{display:block!important;visibility:visible!important;opacity:1!important;position:relative!important;z-index:12000!important;width:100%!important;margin:0!important;padding:0!important;background:#fff!important;pointer-events:auto!important;overflow:visible!important}
.template-index #header-group>.shopify-section{visibility:visible!important;opacity:1!important;margin:0!important;padding:0!important}
.template-index #header-group>.shopify-section:first-child{min-height:34px!important;margin:0!important;padding:0!important;background:#f0d55c!important;color:#111!important}
.template-index #header-group>.shopify-section:first-child *{color:#111!important}
.template-index #header-group .header-section{min-height:82px!important;margin:0!important;padding:0!important;background:#fff!important;box-shadow:0 1px 0 rgba(17,17,17,.10)!important;border:0!important}
.template-index #header-component{min-height:82px!important;margin:0!important;background:#fff!important;color:#111!important;box-shadow:none!important;border:0!important}
.template-index #header-component .header,.template-index #header-component .header__row,.template-index #header-component .header__row--top,.template-index #header-component .header__row--bottom{min-height:82px!important;margin:0!important;background:#fff!important;box-shadow:none!important;border:0!important}
.template-index #header-component *{color:#111!important}
.template-index #header-component svg{stroke:currentColor!important}
.template-index #header-component .header-menu,.template-index #header-component nav.header-menu,.template-index #header-component overflow-list{visibility:visible!important;opacity:1!important;max-width:none!important}
.template-index #header-component header-actions,.template-index #header-component [class*="header-actions"],.template-index #header-component [class*="header__actions"]{display:flex!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important}
.template-index #header-component .header-actions__action,.template-index #header-component .search-action,.template-index #header-component .header__icon{display:flex!important;visibility:visible!important;opacity:1!important;align-items:center!important;justify-content:center!important;min-width:42px!important;min-height:42px!important}
.template-index #header-component .header-actions__action svg,.template-index #header-component .search-action svg,.template-index #header-component .header__icon svg{display:block!important;visibility:visible!important;opacity:1!important;width:20px!important;height:20px!important}
/* Use one logo source only. Shopify has no logo assigned in settings, so the theme fallback text was appearing on top of the custom image. */
.template-index #header-component .header-logo{display:flex!important;visibility:visible!important;opacity:1!important;width:240px!important;max-width:28vw!important;height:54px!important;justify-content:center!important;align-items:center!important;background:url('{{ '00_logo.jpg' | asset_url }}') center/contain no-repeat!important;overflow:hidden!important;font-size:0!important;color:transparent!important;text-indent:-9999px!important}
.template-index #header-component .header-logo>span,.template-index #header-component .header-logo img,.template-index #header-component .header-logo svg{visibility:hidden!important;opacity:0!important}
.template-index #MainContent{position:relative!important;z-index:1!important;margin:0!important;padding:0!important}
.template-index .mvx-announcement,.template-index .mvx-home-header{display:none!important}
@media(min-width:750px){.template-index #header-component .header__drawer,.template-index #header-component menu-drawer,.template-index #header-component .header__icon--menu{display:none!important}.template-index #header-component .header-menu{display:flex!important;visibility:visible!important;opacity:1!important}}
@media(min-width:990px){.template-index #header-component .header{padding-inline:clamp(28px,4vw,60px)!important}}
@media(max-width:749px){.template-index #header-group>.shopify-section:first-child{min-height:32px!important}.template-index #header-group .header-section,.template-index #header-component,.template-index #header-component .header,.template-index #header-component .header__row,.template-index #header-component .header__row--top,.template-index #header-component .header__row--bottom{min-height:68px!important}.template-index #header-component .header{padding-inline:14px!important}.template-index #header-component .header-logo{width:150px!important;max-width:42vw!important;height:42px!important}.template-index #header-component .header__drawer,.template-index #header-component menu-drawer,.template-index #header-component .header__icon--menu{display:flex!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important}.template-index #header-component header-actions{display:flex!important;visibility:visible!important;opacity:1!important}.template-index #header-component .header-actions__action{display:flex!important;visibility:visible!important;opacity:1!important;min-width:40px!important;min-height:40px!important}}
</style>
</head>
<body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }} template-{{ template.name | handle }}">
{% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}{% render 'chat-drawer' %}
<div class="page-wrapper"><div id="header-group">{% sections 'header-group' %}</div>
<main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="{{ settings.page_transition_enabled }}" data-product-transition="{{ settings.transition_to_main_product }}" data-template="{{ template }}">{{ content_for_layout }}</main>
<footer>{% sections 'footer-group' %}</footer></div>
{% render 'cart-drawer', render_wrapper: true %}{% render 'theme-drawer' %}{% render 'search-modal' %}{% if settings.quick_add or settings.mobile_quick_add %}{% render 'quick-add-modal' %}{% endif %}
<script src="{{ 'marie-vogue-motion.js' | asset_url }}" defer></script>
</body></html>